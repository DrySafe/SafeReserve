    },
    {
      "id": "resolve-conversation",
      "name": "Resolve conversation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2420,
        0
      ],
      "parameters": {
        "jsCode": "const event=$('Pick conversation').first().json;const id=event.conversationId||$json.id||$json.payload?.id;if(!id)throw new Error('Conversation ID missing');return [{json:{...event,conversationId:id}}];"
      }
    },
    {
