      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2860,
        0
      ],
      "parameters": {
        "jsCode": "const event=$('Resolve conversation').first().json;const list=$json.payload||[];return [{json:{...event,alreadySent:list.some(m=>m.content_attributes?.safereserve_event_id===event.event_id)}}];"
      }
